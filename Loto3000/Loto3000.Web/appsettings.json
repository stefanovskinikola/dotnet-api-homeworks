{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Loto3000Db;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "Loto3000",
    "Audience": "Loto3000.Web",
    "ExpirationMinutes": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
